arts":[[2019,1,28]],"date-time":"2019-01-28T11:42:58Z","timestamp":1548675778000},"source":"Crossref","is-referenced-by-count":0,"title":["Luminescence of Polybromide Defects in Cs4PbBr6"],"prefix":"10.26434","author":[{"ORCID":"https:\/\/orcid.org\/0000-0003-3848-8163","authenticated-orcid":false,"given":"Young-Kwang","family":"Jung","sequence":"first","affiliation":[{"name":"Yonsei University","place":["Korea"]}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Joaquin","family":"Calbo","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Ji-Sang","family":"Park","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Lucy D.","family":"Whalley","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Sunghyun","family":"Kim","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-5460-7033","authenticated-orcid":false,"given":"Aron","family":"Walsh","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"316","link":[{"URL":"https:\/\/chemrxiv.org\/doi\/pdf\/10.26434\/chemrxiv.7629467.v1","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,5,14]],"date-time":"2026-05-14T08:45:03Z","timestamp":1778748303000},"score":25.772104,"resource":{"primary":{"URL":"https:\/\/chemrxiv.org\/doi\/full\/10.26434\/chemrxiv.7629467.v1"}},"issued":{"date-parts":[[2019,1,28]]},"references-count":0,"URL":"https:\/\/doi.org\/10.26434\/chemrxiv.7629467.v1","relation":{"has-version":[{"id-type":"doi","id":"10.26434\/chemrxiv.7629467.v2","asserted-by":"object"}]},"published":{"date-parts":[[2019,1,28]]},"subtype":"preprint"}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}