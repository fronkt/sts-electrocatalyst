294"],"issn-type":[{"value":"2451-9294","type":"print"}],"published":{"date-parts":[[2017,5]]},"assertion":[{"value":"Elsevier","name":"publisher","label":"This article is maintained by"},{"value":"The Role of Ru Redox in pH-Dependent Oxygen Evolution on Rutile Ruthenium Dioxide Surfaces","name":"articletitle","label":"Article Title"},{"value":"Chem","name":"journaltitle","label":"Journal Title"},{"value":"https:\/\/doi.org\/10.1016\/j.chempr.2017.04.001","name":"articlelink","label":"CrossRef DOI link to publisher maintained version"},{"value":"article","name":"content_type","label":"Content Type"},{"value":"\u00a9 2017 Elsevier Inc.","name":"copyright","label":"Copyright"}]},{"indexed":{"date-parts":[[2025,5,2]],"date-time":"2025-05-02T04:12:55Z","timestamp":1746159175695,"version":"3.40.4"},"posted":{"date-parts":[[2025]]},"group-title":"SSRN","reference-count":0,"publisher":"Elsevier BV","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.2139\/ssrn.5238269","type":"posted-content","created":{"date-parts":[[2025,5,1]],"date-time":"2025-05-01T16:36:56Z","timestamp":1746117416000},"source":"Crossref","is-referenced-by-count":0,"title":["Surface Orientation Dependent\u00a0Acidic Oxygen Evolution Activity, Stability, and Elemental Dissolution of Ruo2 and Iro2"],"prefix":"10.2139","author":[{"given":"Naomi","family":"Naraki","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Yuto","family":"Okayama","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Naoto","family":"Todoroki","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"78","deposited":{"date-parts":[[2025,5,1]],"date-time":"2025-05-01T16:36:56Z","timestamp":1746117416000},"score":53.76179,"resource":{"primary":{"URL":"https:\/\/www.ssrn.com\/abstract=5238269"}},"issued":{"date-parts":[[2025]]},"references-count":0,"URL":"https:\/\/doi.org\/10.2139\/ssrn.5238269","published":{"date-parts":[[2025]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2026,5,14]],"date-time":"2026-05-14T11:09:49Z","timestamp":1778756989012,"version":"3.51.4"},"posted":{"date-parts":[[2026,3,3]]},"reference-count":0,"publisher":"American Chemical Society (ACS)","content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>\n                  Rutile iridium dioxide (IrO\n                  <jats:sub>2<\/jats:sub>\n                  ) is a benchmark catalyst for heterogeneous electrooxidation reactions including the oxygen and chlorine evolution reactions (OER, CER), with broad applications such as water splitting, water treatment, chlor-alkali electrolysis, and chlorine-mediated electrosynthesis reactions. Intrinsic OER activities and mechanisms are well established for low index crystallographic facets of IrO\n                  <jats:sub>2<\/jats:sub>\n                  . However, corresponding understanding of CER activity and selectivity is not yet well understood beyond its reactivity on the most thermodynamically stable (110) surface. Here we experimentally show that the (110) and (100) facets have higher OER activity and lower CER selectivity compared to (101) and (001) IrO\n                  <jats:sub>2<\/jats:sub>\n                  epitaxial thin films. We compute unique facet-dependence in the binding energies between reactive intermediates, where OER adsorbates are stabilized by bridging oxygen atoms on the least CER-selective facets (110) and (100). The potential- and concentration-dependence of experimental combined reaction rate order suggests dynamic intermediate coverage changes in this regime drive differences in CER selectivity across facets. These facets show unique differences in activity between perchloric and sulfuric acid electrolytes, highlighting differences in competitive anion adsorption. These results indicate that facet-engineering manipulates the local reaction environment to independently tailor OER and CER rates, providing control over selectivity in competitive electrooxidation conditions.\n                <\/jats:p>","DOI":"10.26434\/chemrxiv.15000581\/v1","type":"posted-content","created":{"date-parts":[[2026,3,4]],"date-time":"2026-03-04T04:51:31Z","timestamp":1772599891000},"source":"Crossref","is-referenced-by-count":0,"title":["Facet-Dependent Selectivity of Rutile IrO2 for Oxygen and Chlorine Evolution Reactions"],"prefix":"10.26434","author":[{"given":"Molly E","family":"Vitale-Sullivan","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Rajkumar","family":"Jana","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Sreejith","family":"Nair","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Seung Gyo","family":"Jeong","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Matthew","family":"Neurock","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Bharat","family":"Jalan","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Kelsey A","family":"Stoerzinger","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"316","link":[{"URL":"https:\/\/chemrxiv.org\/doi\/pdf\/10.26434\/chemrxiv.15000581\/v1","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,5,14]],"date-time":"2026-05-14T10:11:07Z","timestamp":1778753467000},"score":52.69453,"resource":{"primary":{"URL":"https:\/\/chemrxiv.org\/doi\/full\/10.26434\/chemrxiv.15000581\/v1"}},"issued":{"date-parts":[[2026,3,3]]},"references-count":0,"URL":"https:\/\/doi.org\/10.26434\/chemrxiv.15000581\/v1","relation":{"is-preprint-of":[{"id-type":"doi","id":"10.1149\/MA2023-01502577mtgabs","asserted-by":"subject"}]},"published":{"date-parts":[[2026,3,3]]},"subtype":"preprint"}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}