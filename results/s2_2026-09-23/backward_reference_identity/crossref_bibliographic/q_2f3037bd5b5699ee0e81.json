e},"short-container-title":["Angewandte Chemie"],"published-print":{"date-parts":[[2014,10,6]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>\n                    In the industrially important Chlor\u2010Alkali process, the chlorine evolution reaction (CER) over a ruthenium dioxide (RuO\n                    <jats:sub>2<\/jats:sub>\n                    ) catalyst competes with the oxygen evolution reaction (OER). This selectivity issue is elucidated on the microscopic level with the single\u2010crystalline model electrode RuO\n                    <jats:sub>2<\/jats:sub>\n                    (110) by employing density functional theory (DFT) calculations in combination with the concept of volcano plots. We demonstrate that one monolayer of TiO\n                    <jats:sub>2<\/jats:sub>\n                    (110) supported on RuO\n                    <jats:sub>2<\/jats:sub>\n                    (110) enhances the selectivity towards the CER by several orders of magnitudes, while preserving the high activity for the CER. This win\u2010win situation is attributed to the different slopes of the volcano curves for the CER and OER.\n                  <\/jats:p>","DOI":"10.1002\/ange.201406112","type":"journal-article","created":{"date-parts":[[2014,8,25]],"date-time":"2014-08-25T07:41:44Z","timestamp":1408952504000},"page":"11212-11215","source":"Crossref","is-referenced-by-count":72,"title":["Controlling Selectivity in the Chlorine Evolution Reaction over RuO\n                    <sub>2<\/sub>\n                    \u2010Based Catalysts"],"prefix":"10.1002","volume":"126","author":[{"given":"Kai S.","family":"Exner","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Josef","family":"Anton","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Timo","family":"Jacob","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Herbert","family":"Over","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2014,8,25]]},"reference":[{"key":"e_1_2_2_1_2","doi-asserted-by":"publisher","DOI":"10.1002\/9783527610044"},{"key":"e_1_2_2_2_2","volume-title":"Principles and Practice of Heterogeneous Catalysis","author":"Thomas J. M.","year":"1997"},{"key":"e_1_2_2_3_2","doi-asserted-by":"publisher","DOI":"10.1038\/nchem.121"},{"key":"e_1_2_2_4_2","doi-asserted-by":"publisher","DOI":"10.1021\/ie101300c"},{"key":"e_1_2_2_5_2","doi-asserted-by":"publisher","DOI":"10.1021\/cr9001808"},{"key":"e_1_2_2_6_2","unstructured":"\u00a0"},{"key":"e_1_2_2_7_2","doi-asserted-by":"publisher","DOI":"10.1016\/S0013-4686(00)00338-8"},{"key":"e_1_2_2_8_2","doi-asserted-by":"publisher","DOI":"10.1021\/ac200677g"},{"key":"e_1_2_2_9_2","doi-asserted-by":"publisher","DOI":"10.1023\/A:1003269228566"},{"key":"e_1_2_2_10_2","doi-asserted-by":"publisher","DOI":"10.1016\/j.jelechem.2006.11.008"},{"key":"e_1_2_2_11_2","doi-asserted-by":"publisher","DOI":"10.1039\/B917459A"},{"key":"e_1_2_2_12_2","doi-asserted-by":"publisher","DOI":"10.1002\/cphc.201000286"},{"key":"e_1_2_2_13_2","doi-asserted-by":"publisher","DOI":"10.1103\/PhysRevB.73.165402"},{"key":"e_1_2_2_14_2","doi-asserted-by":"publisher","DOI":"10.1007\/s12678-012-0088-z"},{"key":"e_1_2_2_15_2","doi-asserted-by":"publisher","DOI":"10.1016\/j.electacta.2012.04.062"},{"key":"e_1_2_2_16_2","doi-asserted-by":"publisher","DOI":"10.1039\/c3sc50205h"},{"key":"e_1_2_2_17_2","doi-asserted-by":"publisher","DOI":"10.1002\/9780470463772.ch5"},{"key":"e_1_2_2_18_2","volume-title":"Atlas of Electrochemical Equilibria in Aqueous Solutions","year":"1974"},{"key":"e_1_2_2_19_2","doi-asserted-by":"publisher","DOI":"10.1016\/j.electacta.2013.11.027"},{"key":"e_1_2_2_20_2","doi-asserted-by":"publisher","DOI":"10.1016\/0022-0728(87)80119-5"},{"key":"e_1_2_2_21_2","doi-asserted-by":"publ