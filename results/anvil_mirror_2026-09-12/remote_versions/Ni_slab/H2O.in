&CONTROL
  calculation = 'relax'
  prefix = 'H2O'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 100
/
&SYSTEM
  ibrav = 1
  celldm(1) = 22.67671
  nat = 3
  ntyp = 2
  ecutwfc = 80.0
  ecutrho = 640.0
  assume_isolated = 'mt'
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.5
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  H  1.008  H.pbe-rrkjus_psl.1.0.0.UPF
  O  15.999  O.pbe-n-kjpaw_psl.0.1.UPF
ATOMIC_POSITIONS angstrom
  O  6.000000  5.608667  6.000000
  H  6.758000  6.195667  6.000000
  H  5.242000  6.195667  6.000000
K_POINTS gamma
