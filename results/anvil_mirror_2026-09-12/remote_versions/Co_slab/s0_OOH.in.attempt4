&CONTROL
  calculation = 'relax'
  prefix = 's0_OOH'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 200
/
&SYSTEM
  ibrav = 0
  nat = 21
  ntyp = 3
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 2
  nosym = .true.
  noinv = .true.
  starting_magnetization(1) = 0.4
  starting_magnetization(2) = 0.0
  starting_magnetization(3) = 0.0
/
&ELECTRONS
  mixing_ndim = 16
  diagonalization = 'david'
  conv_thr = 1.0d-6
  mixing_mode = 'local-TF'
  mixing_beta = 0.05
  electron_maxstep = 800
/
&IONS
  ion_dynamics = 'bfgs'
/
