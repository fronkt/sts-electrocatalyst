g 9/1.Roundness", "68624074": "Fig/Fig 8", "68624083": "Fig/Fig 8", "68624077": "Fig/Fig 8", "68624092": "Fig/Fig 6", "68624086": "Fig/Fig 6", "68624095": "Fig/Fig 6", "68624089": "Fig/Fig 6", "68624080": "Fig/Fig 7", "68624098": "Fig/Fig 6", "68624101": "Fig/Fig 6", "68624104": "Fig/Fig 6", "68624107": "Fig/Fig 6", "68624110": "Fig/Fig 6", "68624113": "Fig/Fig 6", "68624116": "Fig/Fig 6", "68624125": "Fig/Fig 6", "68624122": "Fig/Fig 6", "68624134": "Fig/Fig 6", "68624128": "Fig/Fig 6", "68624119": "Fig/Fig 6", "68624131": "Fig/Fig 6", "68624137": "Fig/Fig 5", "68624140": "Fig/Fig 6", "68624143": "Fig/Fig 5", "68624146": "Fig/Fig 4", "68624149": "Fig/Fig 4", "68624152": "Fig/Fig 4", "68624155": "Fig/Fig 4", "68624158": "Fig/Fig 2", "68624161": "Fig/Fig 2", "68624164": "Fig/Fig 1", "68624167": "Fig/Fig 3", "68624170": "Fig/Fig 1"}, "authors": [{"id": 24927421, "full_name": "Xiaojing Li", "first_name": "Xiaojing", "last_name": "Li", "is_active": true, "url_name": "Xiaojing_Li", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/Supporting_data_for_the_compression_behaviour_and_pore-throat_reorganisation_of_intact_Quaternary_clays/33786703", "download_disabled": false, "description": "<p dir=\"ltr\">This dataset contains the figures and image-based materials generated from the study of two intact Quaternary clays with contrasting compressibility. The dataset includes particle-size distribution figures, X-ray diffraction results, one-dimensional compression curves, mercury intrusion porosimetry (MIP) pore-throat distribution figures, environmental scanning electron microscopy (ESEM) images, and quantitative microstructural analysis figures. These materials document the contrasting compression responses, pore-throat reorganisation characteristics, and microstructural evolution of the medium-to-low-compressibility (MLC) and medium-to-high-compressibility (MHC) clays under different vertical stresses.</p>", "funding": null, "fund