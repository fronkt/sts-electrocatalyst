ink_only": false, "download_url": "https://ndownloader.figshare.com/files/68075560", "supplied_md5": "84d177a8e8f5d48cc394d9ac75143b3d", "computed_md5": "84d177a8e8f5d48cc394d9ac75143b3d", "mimetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}], "folder_structure": {}, "authors": [{"id": 23412420, "full_name": "Samuele Lamon", "first_name": "Samuele", "last_name": "Lamon", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-8475-7785"}, {"id": 25072550, "full_name": "Peter M. Bourke", "first_name": "Peter M.", "last_name": "Bourke", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-0665-6508"}, {"id": 25072561, "full_name": "Brian L. Abernathy", "first_name": "Brian L.", "last_name": "Abernathy", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 25072578, "full_name": "Jo\u00e3o F. dos Santos", "first_name": "Jo\u00e3o F.", "last_name": "dos Santos", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9481-4547"}, {"id": 25072584, "full_name": "Ign\u00e1cio J. de Godoy", "first_name": "Ign\u00e1cio J.", "last_name": "de Godoy", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10891784, "full_name": "Soraya C. M. Leal-Bertioli", "first_name": "Soraya C. M.", "last_name": "Leal-Bertioli", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9683-5357"}, {"id": 11953112, "full_name": "David J. Bertioli", "first_name": "David J.", "last_name": "Bertioli", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "Article title", "value": "Double Reduction in Allotetraploid Peanut and the Role of Chromosomal Imbalance in Unexpected Linkage Map Artifacts", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Please add your article title"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Manuscript #", "value": "G3-2026-406930-TR1", "settings": {"validations": {"min_length": 10, "max_length": 1000}, "placeholder": "Please add your manuscript #"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Article DOI", "value": "", "settings": {"validations": {"min_length": 10, "max_length": 1000}, "placeholder": "Please add your article DOI"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://gsajournals.figshare.com/articles/dataset/Supplementary_Material_for_Lamon_et_al_2026/33399301", "download_disabled": false, "description": "<p dir=\"ltr\">Double reduction is a rare polyploid-specific segregation pattern in which a single-dosage locus produces a duplex gamete. Although peanut (<i>Arachis hypogaea</i>) mainly shows disomic pairing, its segmental allotetraploid genome can occasionally form multivalents, allowing double reduction to occur. We detected double reduction using a backcross population between cultivated peanut and the neoallotetraploid [<i>A. magna</i> \u00d7 <i>A. stenosperma</i>]<sup>4x</sup> (MagSten) and a high-density phased linkage map containing 9,717 SNP markers. Initial mapping artifacts were traced to progenies with unbalanced chromosomal compositions caused by homoeologous exchange; removing these individuals resolved the artifacts. Double reduction was detected in 12% of progenies. This deposit contains the supplementary tables and figures supporting the analysis.</p><p dir=\"ltr\">Contents:</p><p dir=\"ltr\">Supplementary Tables S1\u2013S4 \u2014 SNP dosage scores, the final marker set with map positions, pericentromere boundaries, and a summary of DR events by individual and linkage group.</p><p dir=\"ltr\">Supplementary Figures S1\u2013S12 \u2014 Marker filtering and dosage-type distributions, concordance between genotype-calling phase and linkage-map phase, the genome-wide distribution of interspersed genotyping patterns, step-by-step construction of pseudo-integrated linkage maps across chromosomes via centromere alignment, heatmaps of cross-linkage-group LOD scores, and Hidden Markov Model analyses, including genotyping error-rate diagnostics and posterior identity-by-descent probability visualizations, used to independently evaluate candidate DR and homoeologous exchange events.</p><p dir=\"ltr\">Supplementary_Figure_Legends \u2014 full legends for Supplementary Figures 1\u201312.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 16207778, "created_date": "2026-09-18T14:25:34Z", "modified_date": "2026-09-18T14:25:35Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Arachis hypogaea", "polyploidy", "double reduction", "homoeologous exchange", "genetic instability", "linkage mapping", "segmental allopolyploidy"], "keywords": ["Arachis hypogaea", "polyploidy", "double reduction", "homoeologous exchange", "genetic instability", "linkage mapping", "segmental allopolyploidy"], "categories": [{"id": 24310, "title": "Genomics", "parent_id": 24283, "path": "/24130/24283/24310", "source_id": "310509", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Lamon, Samuele; Bourke, Peter M.; Abernathy, Brian L.; dos Santos, Jo\u00e3o F.; de Godoy, Ign\u00e1cio J.; Leal-Bertioli, Soraya C. M.; et al. (2026). Supplementary Material for Lamon et al., 2026. GSA Journals. Dataset. https://doi.org/10.25387/g3.33399301.v1", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 33399301, "title": "Supplementary Material for Lamon et al., 2026", "doi": "10.25387/g3.33399301.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/33399301", "published_date": "2026-09-18T14:25:34Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-gsa-2154777912/68075437/thumb.png", "defined_type": 3, "defined_type_name": "dataset", "group_id": 17116, "url_private_api": "https://api.figshare.com/v2/account/articles/33399301", "url_public_api": "https://api.figshare.com/v2/articles/33399301", "url_private_html": "https://figshare.com/account/articles/33399301", "url_public_html": "https://gsajournals.figshare.com/articles/dataset/Supplementary_Material_for_Lamon_et_al_2026/33399301", "timeline": {"posted": "2026-09-18T14:25:34"}, "resource_title": null, "resource_doi": null}