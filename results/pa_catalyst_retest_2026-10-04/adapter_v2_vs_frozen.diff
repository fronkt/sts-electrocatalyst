+def expected_xml_strings(deck):
+    """The <input> strings QE 7.5 must write for this deck, after canonicalization.
+
+    Keyed by XML tag.  This is the complete set of deck strings that the XML check
+    compares; a deck string without a QE75_XML_CANONICAL rule raises here, offline,
+    before any QE call is paid for.
+    """
+    sections = deck["settings"]["namelists"]
+    system, electrons = sections["system"], sections["electrons"]
+    control, ions = sections["control"], sections.get("ions", {})
+    pairs = [(key, deck["operations"][key]) for key in ("calculation", "restart_mode", "prefix")]
+    pairs += [(key, control[key]) for key in ("disk_io", "verbosity") if key in control]
+    pairs += [(key, electrons[key]) for key in ("mixing_mode", "diagonalization") if key in electrons]
+    pairs += [(key, ions[key]) for key in ("ion_dynamics",) if key in ions]
+    pairs += [(key, system[key]) for key in ("occupations",) if key in system]
+    pairs.append(("functional", system.get("input_dft", "PBE")))
+    if deck["settings"]["hubbard"] is not None:
+        pairs.append(("U_projection_type", deck["settings"]["hubbard"]["unit"]))
+    return {tag: _xml_canonical(tag, raw) for tag, raw in pairs if raw is not None}
