+def _xml_canonical(key, value):
+    """The string QE 7.5 writes into <input> for a deck string (QE75_XML_CANONICAL)."""
+    rule = QE75_XML_CANONICAL.get(key)
+    if rule is None or not isinstance(value, str):
+        raise AdapterError("no QE 7.5 XML canonicalization rule for " + str(key))
+    if rule["kind"] == "map":
+        return rule["map"].get(value, value)
+    if rule["kind"] == "upper":
+        return value.upper()
+    if rule["kind"] == "smearing":
+        return _schema_smearing(value)
+    return value
+
