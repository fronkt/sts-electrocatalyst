+def replay_real_control(spec: dict, adapter) -> dict:
+    """Read the real control call of job 21034683 through the staged adapter; refuse on any mismatch."""
+    replay = spec["preflight_replay"]
+    root = _plain_path(Path(replay["root"]))
+    for entry in replay["files"]:
+        verify_pin({"path": str(root / entry["path"]), "sha256": entry["sha256"]}, "preflight replay fixture")
+    manifest = {row["fixture"]: row for row in json.loads((root / "manifest.json").read_text(encoding="utf-8"))}
+    registered_upfs = {Path(pin["path"]).name: pin["sha256"] for pin in spec["upfs"]}
+    with tempfile.TemporaryDirectory(prefix="pa_replay_", dir=str(_plain_path(Path(spec["trial_parent"])))) as name:
+        scratch = Path(name)
+        for entry in replay["files"]:
+            if entry["path"] == "manifest.json":
+                continue
+            raw = gzip.decompress((root / entry["path"]).read_bytes())
+            row = manifest[entry["path"]]
+            if len(raw) != row["bytes"] or hashlib.sha256(raw).hexdigest() != row["sha256"]:
+                raise TrialError("replay fixture differs from its recorded original: " + entry["path"])
+            target = scratch / entry["path"][len("control/"):-len(".gz")]
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(raw)
+        pins = {path.name: sha256_file(path) for path in sorted((scratch / "common_pseudo").iterdir())}
+        if pins != registered_upfs:
+            raise TrialError("replayed pseudopotentials are not the registered pins")
+        expected = adapter.parse_deck(scratch / "input.in")
+        expected["upf_pins"] = pins
+        expected["upf_read_path_map"] = {replay["logged_upf_dir"] + n: str(scratch / "common_pseudo" / n) for n in pins}
+        receipt = json.loads((scratch / "process_receipt.json").read_text(encoding="utf-8"))
+        arm = adapter.read_qe_arm(scratch / "input.in", scratch / "stdout.log", scratch / "stderr.log",
+                                  scratch / "data-file-schema.xml", receipt, expected_settings=expected,
+                                  expected_parallel=SHAPE, expected_exit="clean_stop", expected_evaluations=3)
+        adapter.require_expected_first_threshold(arm, expected)
+        last = arm["evaluations"][-1]
+        saved = adapter.read_bfgs(scratch / (PREFIX + ".bfgs"), nat=72, cell_bohr=last["geometry"]["cell"], evaluated=last)
+        observed = {"evaluations": len(arm["evaluations"]), "scf_counts": arm["scf_counts"],
+                    "saved_optimizer_counters": [saved["scf_count"], saved["bfgs_count"], saved["gdiis_count"]],
+                    "xml_settings_identity": arm["xml_settings_identity"]}
+    if observed != REPLAY_EXPECTED:
+        raise TrialError("real control replay differs from the registered result: " + json.dumps(observed))
+    return dict(observed, replayed=True, staged_adapter=str(Path(adapter.__file__).absolute()))
+
