+def conv_thr_carry(candidate_stdout: Path, resumed_conv_thr: float) -> dict:
+    """The conv_thr in effect when the candidate stopped must equal the resumed deck's conv_thr."""
+    found = NEW_CONV_THR.findall(Path(candidate_stdout).read_text(encoding="utf-8", errors="replace"))
+    carried = float(found[-1].replace("D", "E").replace("d", "e")) if found else None
+    equal = (carried is not None and resumed_conv_thr > 0
+             and abs(carried - resumed_conv_thr) <= 1e-9 * resumed_conv_thr)
+    return {"candidate_last_new_conv_thr_Ry": carried, "resumed_deck_conv_thr_Ry": resumed_conv_thr,
+            "new_conv_thr_lines": len(found), "equal": equal}
