# Scratch / local working files
*.tmp
*.log
.DS_Store
Thumbs.db

# Data / model artifacts (keep the repo about ideas + plans, not large blobs)
data/*
# ...except the pinned tiers of record. These are the frozen scientific baselines
# every figure and statistic is computed against (docs/43 s0); they are small, they
# are write-once, and losing them would make past claims unreproducible.
!data/tiers/
!data/tiers/*.json
results/
checkpoints/
*.ckpt
*.pt
*.pth
*.npz
__pycache__/
.ipynb_checkpoints/
.venv/

# fairchem lives in an isolated venv (torch~=2.8 vs the main env 2.11); docs/39 s5
.venv-fairchem/

# QE per-job scratch. run_one() creates ./tmp_<job>/ next to the deck and removes it on a
# clean exit; a killed or crashed job leaves it behind. One of these was 26 MB.
tmp_*/

# Publisher PDFs pulled through the Purdue library. This repo is PUBLIC; redistributing
# a paywalled publisher PDF is a copyright problem regardless of how it was obtained.
# The reading copies stay local, the index (papers/README.md) is what gets committed.
docs/research/papers/*.pdf

# Driver-rewritten runtime copies (queue_r1.sh rewrites outdir/pseudo_dir into .run.in
# next to each deck). The sources of record are the committed .in decks; these are
# machine artifacts pulled back with output rsyncs. Never bankable.
*.run.in

# projwfc.x projection bodies. The registered Lowdin artifact is the few-kB
# `<job>.lowdin.txt` extract (A6.5(1)); the full `.projwfc.out` bodies and the
# per-orbital pdos files are ~25-54k lines each and are retained on Anvil beside
# their decks, not in git. This rule encodes the 2026-08-28 banking choice so a
# bulk `runs/` add cannot silently reverse it.
*.projwfc.out
*.pdos_atm*
