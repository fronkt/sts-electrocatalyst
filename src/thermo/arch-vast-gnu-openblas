#=====================================================================
# MuST architecture file for a generic Ubuntu 24.04 Vast.ai CPU box
# (GNU 13 + OpenMPI 4.1 + apt OpenBLAS/ScaLAPACK; FFTW/LibXC/Lua built
# from MuST's bundled external/ sources — leave their paths empty).
# Deploy: cp to MuST/architecture/vast-gnu-openblas && make vast-gnu-openblas
#=====================================================================
Acceleration = 0

# P3DFFT 2.7.9 won't compile under gfortran >=10 (its configure drops our
# -fallow-argument-mismatch); it is only needed for full-potential parallel
# FFT, not for the KKR-CPA/Kubo muffin-tin work this box does. Official switch:
NotUse_P3DFFT = 1

HDF5_PATH   =
ACCEL       =
ACCEL_PATH  =
LIBXC_PATH  =
FFTW_PATH   =
P3DFFT_PATH =
LUA_PATH    =
LIBS       += -L/usr/lib/x86_64-linux-gnu -lscalapack-openmpi -lopenblas -llapack -lgfortran -lm

#=====================================================================
# Compiler tools
#=====================================================================
CC          = mpicc
CXX         = mpicxx
F77         = mpif77
FC          = mpif90
MPICC       = mpicc
ACCEL_CXX   =
ARCHV       = ar -r

#=====================================================================
# Preprocessor/Compiler/Linker flags
# -fallow-argument-mismatch: gfortran >=10 hard-errors on legacy MPI
# argument mismatches in the F77-era sources; this restores the old
# warning behaviour.
#=====================================================================
FPPDEFS     = -cpp
CPPDEFS     =
FPPFLAGS    = -DMPI -DMaxOutProcs=1

CFLAGS      = -O3
CXXFLAGS    = -O3 -std=c++14
FFLAGS      = -O3 -I. -fallow-argument-mismatch
F77FLAGS    = -O3 -I. -fallow-argument-mismatch
OPT_OPENMP  = -fopenmp

LD_FLAGS    =
LD          = $(FC) $(LD_FLAGS)

#=====================================================================
# ./configure flags for the bundled external packages
#=====================================================================
HDF5_CONFIG_FLAGS   = --enable-fortran --enable-static-exec CC=$(CC) CXX=$(CXX) FC=$(FC)
LIBXC_CONFIG_FLAGS  = CC=$(CC) CFLAGS="$(CFLAGS)" FC=$(FC) FFLAGS="$(FFLAGS)"
P3DFFT_CONFIG_FLAGS = --enable-openmpi FC=$(FC) CC=$(CC) LIBS="$(LIBS)" CCLD=$(FC)
FFTW_CONFIG_FLAGS   = --enable-mpi --enable-fortran CC=$(CC) CFLAGS="$(CFLAGS)" MPICC=$(MPICC) F77=$(F77) FFLAGS="$(FFLAGS)"
