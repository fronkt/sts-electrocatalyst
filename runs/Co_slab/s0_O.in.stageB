&CONTROL
  calculation = 'relax'
  prefix = 's0_O'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 200
/
&SYSTEM
  ibrav = 0
  nat = 19
  ntyp = 2
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 2
  nosym = .true.
  noinv = .true.
  starting_magnetization(1) = 0.4
  starting_magnetization(2) = 0.0
/
