&CONTROL
  calculation = 'relax'
  prefix = 'slab'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 200
/
&SYSTEM
  ibrav = 0
  nat = 18
  ntyp = 2
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nosym = .true.
  noinv = .true.
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_mode = 'local-TF'
  mixing_beta = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
