&CONTROL
  calculation = 'scf'
  prefix = 'sno2__ecut60'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 6
  celldm(1) = 8.95239
  celldm(3) = 0.67261
  nat = 6
  ntyp = 2
  ecutwfc = 60.0
  ecutrho = 480.0
  occupations = 'fixed'
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.3
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Sn  118.710  Sn_pbe_v1.uspp.F.UPF
  O   15.999  O.pbe-n-kjpaw_psl.0.1.UPF
ATOMIC_POSITIONS (crystal)
  Sn  0.000000  0.000000  0.000000
  Sn  0.500000  0.500000  0.500000
  O   0.305600  0.305600  0.000000
  O   0.694400  0.694400  0.000000
  O   0.805600  0.194400  0.500000
  O   0.194400  0.805600  0.500000
K_POINTS (automatic)
  6 6 8 0 0 0
