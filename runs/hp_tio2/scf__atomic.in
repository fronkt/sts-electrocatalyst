&CONTROL
  calculation = 'scf'
  prefix = 'tio2_atomic'
  outdir = './tmp_tio2_atomic'
  pseudo_dir = '/usr/share/espresso/pseudo'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 6
  celldm(1) = 8.68083
  celldm(3) = 0.64408
  nat = 6
  ntyp = 2
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'fixed'
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.3
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Ti  47.867  ti_pbe_v1.4.uspp.F.UPF
  O   15.999  O.pbe-n-kjpaw_psl.0.1.UPF
ATOMIC_POSITIONS (crystal)
  Ti  0.000000  0.000000  0.000000
  Ti  0.500000  0.500000  0.500000
  O   0.304780  0.304780  0.000000
  O   0.695220  0.695220  0.000000
  O   0.804780  0.195220  0.500000
  O   0.195220  0.804780  0.500000
K_POINTS (automatic)
  6 6 8 0 0 0
HUBBARD (atomic)
U Ti-3d 1.d-8
