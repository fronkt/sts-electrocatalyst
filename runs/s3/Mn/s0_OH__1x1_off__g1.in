  nosym = .true.
  nspin = 2
  starting_magnetization(1) = 0.0
  starting_magnetization(2) = 0.5
  starting_magnetization(3) = 0.0
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_mode = 'local-TF'
  mixing_beta = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
