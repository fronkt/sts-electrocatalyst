  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 200
  max_seconds = 165000
/
&SYSTEM
  ibrav = 0
  nat = 20
  ntyp = 3
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
