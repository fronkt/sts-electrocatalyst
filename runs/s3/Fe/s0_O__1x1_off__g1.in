&CONTROL
  calculation = 'scf'
  prefix = 's0_O__1x1_off__g1'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 200
  max_seconds = 165000
/
&SYSTEM
  ibrav = 0
  nat = 19
  ntyp = 2
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'smearing'
  smearing = 'mv'
