&CONTROL
  calculation = 'scf'
  prefix = 's0_OOH__1x1_off__basin__g1__fp'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  forc_conv_thr = 2.0d-3
  nstep = 200
  max_seconds = 165000
/
&SYSTEM
  ibrav = 0
  nat = 21
  ntyp = 3
  ecutwfc = 80.0
  ecutrho = 640.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nosym = .true.
  nspin = 2
  starting_magnetization(1) = 0.5
  starting_magnetization(2) = 0.0
  starting_magnetization(3) = 0.0
/
&ELECTRONS
  startingpot = 'file'
  conv_thr = 1.0d-6
  mixing_mode = 'local-TF'
  mixing_beta = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
